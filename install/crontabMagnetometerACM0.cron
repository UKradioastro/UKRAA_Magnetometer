
# UKRAA Magnetometer crontab entry

# cron entry to process yesterdays raw magnetometer data (run as user pi)
00 04 * * * su - pi -c "sudo /bin/bash /home/pi/UKRAA_Magnetometer/scripts/processData.sh >> /home/pi/UKRAA_Magnetometer/logfiles/log-MagnetometerACM0.txt 2>>/home/pi/UKRAA_Magnetometer/logfiles/log-error.txt"

# cron entry to refresh rolling data, rolling plots and rolling web assets every 5 minutes
*/5 * * * * /bin/bash /home/pi/UKRAA_Magnetometer/scripts/processRollingData.sh >> /home/pi/UKRAA_Magnetometer/logfiles/log-MagnetometerACM0.txt 2>> /home/pi/UKRAA_Magnetometer/logfiles/log-error.txt

# cron entry to manage logfiles - on a Sunday 00:00 each week
00 00 * * 00 /bin/bash /home/pi/UKRAA_Magnetometer/scripts/manageLogfiles.sh

# cron entry to upload plot files to www
30 09 * * * /bin/bash /home/pi/UKRAA_Magnetometer/scripts/moveGraphs.sh >> /home/pi/UKRAA_Magnetometer/logfiles/log-MagnetometerACM0.txt 2>> /home/pi/UKRAA_Magnetometer/logfiles/log-error.txt

# cron entry to write daily health marker after processing + publish should be complete
15 10 * * * /bin/bash /home/pi/UKRAA_Magnetometer/scripts/checkDailyPublishHealthACM0.sh >> /home/pi/UKRAA_Magnetometer/logfiles/log-MagnetometerACM0.txt 2>> /home/pi/UKRAA_Magnetometer/logfiles/log-error.txt

# cron entry to append one-line dashboard summary every 15 minutes
*/15 * * * * /bin/bash /home/pi/UKRAA_Magnetometer/scripts/showDashboardSummaryACM0.sh >> /home/pi/UKRAA_Magnetometer/logfiles/dashboard-summary.log 2>> /home/pi/UKRAA_Magnetometer/logfiles/log-error.txt


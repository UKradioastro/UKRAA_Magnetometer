# Copy this file to:
#   /home/pi/UKRAA_Magnetometer/config/plot.ini
# and edit the values for your environment.
#
# Environment variables MAGNETOMETER_PLOT_HDZ and MAGNETOMETER_PLOT_BI
# still override these values when set.

[plots]
# Set to true to generate a daily H, D, Z plot (horizontal intensity,
# declination, and vertical component in nT).
# Useful for comparing against reference observatories such as the
# British Geological Survey (BGS).
plot_hdz = false

# Set to true to generate a daily B, I plot (total field intensity
# and inclination in nT / degrees).
# Useful for comparing against reference observatories such as the
# British Geological Survey (BGS).
plot_bi = false

# Set to true to download and show the NOAA aurora forecast panel.
# This is enabled by default to keep the webpage aligned with the current
# operational behaviour.
plot_noaa = true

# Select which hemisphere forecast to display:
# north or south
# For northern sites, use "north".
# For southern sites, use "south".
noaa_hemisphere = north

# Set to true to download and show the NOAA planetary Kp forecast.
# The chart includes the NOAA G1-G5 geomagnetic storm scale.
plot_kp = true

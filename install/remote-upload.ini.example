[ftp]
# Set true to enable remote FTP uploads.
enabled = false

# External FTP settings
site = your-upload-ftp
user = your-upload-user
password = your-upload-password
port = your-upload-port

# Base target folder on the remote site.
# Daily images upload to <directory>/yesterday; rolling uploads go into
# <directory>/rolling; webpage plot options go into <directory>/status.
directory = /your-upload-directory

# Connection options
timeout_seconds = 30
passive = true
create_dirs = true

# Plot options are always uploaded to <directory>/status/plot-options.json.
# Optional: when true, rolling uploads also send
# ~/UKRAA_Magnetometer/data/status/current.json
# to <directory>/status/current.json
upload_status_json = false
